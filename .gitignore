# ===========================================
# Anyq - Git Ignore
# ===========================================

# Environment files (CRITICAL - never commit!)
.env
.env.local
.env.*.local

# Deployment docs (contains sensitive instructions)
DEPLOYMENT.md

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
*.egg-info/
*.egg
.eggs/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Docker volumes (local)
mongo_data/
media_data/

# Manim outputs
media/
*.mp4
*.png
*.gif

# Temporary files
*.tmp
*.temp
.cache/
tmp/
temp/

# Frontend specific
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Agent specific
agent/__pycache__/
agent/*.pyc

# Backend specific
backend/__pycache__/
backend/*.pyc

# Secrets and certificates
*.pem
*.key
*.crt
secrets/
# Belt and braces over *.pem above: this is where the TLS key is expected to
# be, and a private key reaching the repository is not a mistake that can be
# taken back.
frontend/certs/

# Local development
.local/
local_settings.py


# Local Python virtualenvs (recreate with: make venv)
.venv/
venv/

# Manim render output + intermediates (generated at runtime)
agent/manim-mcp-server/src/media/

# Throwaway run artefacts (telemetry dumps, screenshots, smoke output)
.artifacts/

# The run log. It lives on its own docker volume; a copy in the working tree
# is something that was pulled out of the container to be read, not source.
runs.jsonl

# Tool caches
.ruff_cache/

# Incremental build state written by `tsc -b`.
*.tsbuildinfo
