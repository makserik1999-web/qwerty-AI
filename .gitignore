# ===========================================
# Anyq - Git Ignore
# ===========================================

# Environment files (CRITICAL - never commit!)
.env
.env.local
.env.*.local

# Deployment docs (contains sensitive instructions)
DEPLOYMENT.md

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
*.egg-info/
*.egg
.eggs/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Docker volumes (local)
mongo_data/
media_data/

# Manim outputs
media/
*.mp4
*.png
*.gif

# Temporary files
*.tmp
*.temp
.cache/
tmp/
temp/

# Frontend specific
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Agent specific
agent/__pycache__/
agent/*.pyc

# Backend specific
backend/__pycache__/
backend/*.pyc

# Secrets and certificates
*.pem
*.key
*.crt
secrets/

# Local development
.local/
local_settings.py


# Local Python virtualenvs (recreate with: python3.12 -m venv .venv)
.venv/
venv/

# Manim render output + intermediates (generated at runtime)
agent/manim-mcp-server/src/media/
