# ===========================================
# Anyq - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============ Required ============

# Gemini API Key (required for AI agent features).
# Leave empty: the app and agent still run - AI features reply with a polite
# "AI functions unavailable" message instead of crashing.
GEMINI_API_KEY=

# Shared secret for the agent channel. The backend refuses agent connections
# without it, and the agent refuses to start without it. Same value in .env
# feeds both services. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_SECRET=change_me_to_a_long_random_string

# ============ Optional ============

# LLM Provider Settings
# spoon_ai reads the model from {PROVIDER}_MODEL - DEFAULT_MODEL alone is ignored.
# Default path is OpenRouter: one key reaches every model, so trying a different
# model is an env change instead of a code change.
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_MODEL=google/gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_MAX_TOKENS=20000

# How hard the model thinks before answering: minimal | low | medium | high,
# or empty to leave the choice to the provider's default.
#
# "low" is not a cost saving, it is a quality one. Measured on the Manim node
# with gemini-3.7-flash: default 24.4s and 2 of 4 scripts rendered; low 16.5s
# and 4 of 4, with longer videos and more animated steps. The system prompt
# already contains the Manim API reference, so the extra deliberation was
# being spent inventing API that is not in it.
#
# NOT re-measured on 3.8-flash. The finding above is about how one model
# spends deliberation on one prompt, so it does not transfer by assumption -
# it is kept because it is the only measurement we have, not because it is
# known to still hold.
#
# Only sent when DEFAULT_LLM_PROVIDER=openrouter - it rides on extra_body,
# which the native Gemini provider does not accept.
LLM_REASONING_EFFORT=low

# Part of every cache key: raising it retires every stored answer at once,
# instead of serving output the current pipeline would no longer produce.
# Bump it whenever the prompts, the MODEL or the renderer change.
#   v1 -> v2  narration (answers before it were rendered silent)
#   v2 -> v3  model default moved from gemini-3.7-flash to 3.8-flash
PIPELINE_VERSION=v4

# How long a video runs when the request does not say: short | medium | long
# (~30-40 / ~50-60 / ~80-90 seconds). The seconds come from a measured rate of
# about 12.9 spoken characters per second; the buckets are approximate by
# design, which is why the interface says "~30-40 sec" and not "35 sec".
# Before this existed the length was whatever the model wrote - 60 to 96
# seconds for the same kind of question. Set it to `long` to stay near that.
VIDEO_LENGTH_DEFAULT=medium

# How much is spent rendering when the request does not say: low | medium |
# high, which are manim's 480p15, 720p30 and 1080p60 - frames as well as
# pixels. Measured on one 37-second scene, rendering only: 11.4s at low
# against 68.8s at high. `low` was the effective default until now, and it was
# never a decision - it is manim's own, and 15 fps is visibly choppy on a
# projector.
EFFORT_DEFAULT=medium

# Used only when DEFAULT_LLM_PROVIDER=gemini (native Google API, no "google/"
# prefix). GEMINI_API_KEY above is still required for screenshot analysis,
# which always calls Google directly.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_TOKENS=20000

# Alternative LLM Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Generation quotas. Authorisation alone does not bound load: signup is open
# and rendering is the most expensive thing here. CONCURRENT=1 is the limit
# that actually protects the agent; the others are comfort ceilings.
# Answers from the library and failed generations do NOT count.
GENERATION_MAX_CONCURRENT=1
GENERATION_MAX_PER_HOUR=15
GENERATION_MAX_PER_DAY=50
GENERATION_QUEUE_MAX=20

# Account creation per IP per hour. A school shares one address, so this is
# loose on purpose. Raise it on a stack you run the test suite against - a
# full run creates around 50 accounts.
SIGNUP_MAX_PER_HOUR=100

# Failed sign-ins per IP per 15 minutes. Successes do not count. Loose for the
# same classroom-behind-one-address reason; the per-account limit (5) is what
# protects a password.
LOGIN_IP_MAX_FAILURES=50

# Database Settings
DATABASE_NAME=anyq_db

# MongoDB authentication. The database runs with `mongod --auth`, so these are
# not optional - with them empty nothing can connect.
#
# Two users, on purpose:
#   root  - administration only. No service ever connects as this.
#   app   - what the backend and the exporter use: readWrite on DATABASE_NAME
#           and nothing else. Index creation is part of readWrite, so the
#           startup that builds indexes still works.
#
# ON A FRESH INSTALL the mongo image creates the root user from these on first
# boot. ON AN EXISTING DATABASE it does not - the image only initialises an
# empty data directory - so run `bash scripts/mongo_enable_auth.sh` once, with
# the stack up, BEFORE the switch to --auth takes effect. That script creates
# both users in place and fills in whichever of these four lines is missing.
#
# Keep the passwords alphanumeric. A password containing @ : / or ? has to be
# percent-encoded inside the mongodb:// URI that compose builds, and a
# half-encoded URI fails in a way that reads like a wrong password.
MONGO_ROOT_USER=anyq_root
MONGO_ROOT_PASSWORD=change-me-40-random-alphanumerics
MONGO_APP_USER=anyq_app
MONGO_APP_PASSWORD=change-me-40-random-alphanumerics

# Frontend Port (default: 3000)
FRONTEND_PORT=3000

# Manim LaTeX Support (1=enabled, 0=disabled)
MANIM_ALLOW_LATEX=1

# CORS allowlist (comma-separated). Credentials are enabled, so "*" is never valid.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TLS
#
# HTTPS_TERMINATED=1 makes the frontend serve HTTPS on 3443 and answer plain
# HTTP with a 301 to it, AND gives the session cookie its Secure flag - one
# switch, so HTTPS cannot be turned on while the cookie still travels in clear
# text. The container refuses to start if the certificate is missing rather
# than quietly serving HTTP, which is the failure nobody would notice.
#
# The certificate is a bind mount of a directory holding two files:
#   fullchain.pem   certificate + intermediate chain
#   privkey.pem     private key
# certbot writes exactly those names under /etc/letsencrypt/live/<domain>/, so
# a real certificate is a change of TLS_CERT_SOURCE and nothing else.
#
# For local testing without a domain: bash scripts/make_dev_cert.sh
HTTPS_TERMINATED=0
TLS_SERVER_NAME=localhost
# Where the two .pem files live on the host.
TLS_CERT_SOURCE=./frontend/certs
# Published HTTPS port. 443 in production - then leave the suffix below empty.
HTTPS_PORT=3443
# Only when the public HTTPS port is NOT 443: the redirect from plain HTTP
# builds its target from the Host header, which carries no port.
TLS_PUBLIC_PORT_SUFFIX=

# Adds the Secure flag independently of HTTPS_TERMINATED. Set it to 1 only
# when TLS is terminated further out - a load balancer this stack does not know
# about. It can only turn the flag ON: setting it to 0 does NOT take the flag
# away while HTTPS_TERMINATED=1, because no deployment wants TLS and a cookie
# in clear text, and a stale 0 left in a .env is exactly how that would happen.
COOKIE_SECURE=0

# Usernames (comma separated) allowed to read /api/admin/cache/stats.
# That endpoint lists the questions people ask most, so this is an
# explicit grant: empty means nobody, which is the default.
ADMIN_USERS=
