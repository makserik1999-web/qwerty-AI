server {
    listen 3000;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 4m;

    # Re-resolve the backend's name instead of trusting the address it had at
    # startup. nginx normally looks an upstream host up once, when the config
    # is loaded, and keeps that address forever - so recreating the backend
    # container gives it a new IP and every request here 502s until nginx is
    # restarted too. That turns an ordinary backend deploy into a site outage,
    # and the site looks broken rather than briefly unavailable.
    #
    # 127.0.0.11 is Docker's embedded DNS, present on user-defined networks.
    # Overridable because it is a Docker detail, not a fact about nginx.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # The name only gets re-resolved when proxy_pass contains a variable, which
    # is why every proxy_pass below goes through $backend rather than naming
    # the host directly.
    set $backend ${BACKEND_URL};

    # Handle SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The AI agent channel must NEVER be reachable from outside: the agent
    # connects to the backend directly over the internal docker network.
    location = /ws/agent {
        return 403;
    }
    location ~ ^/ws/agent(/|$) {
        return 403;
    }

    # Proxy API requests to backend
    location /api {
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy UI WebSocket requests (exact /ws path only; /ws/agent is blocked above)
    location = /ws {
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 7d;
        proxy_buffering off;
    }

    # Proxy media requests to backend (for video files)
    location /media {
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}